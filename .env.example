# Modo da "nuvem": off | local | amplify
#  off     = app 100% offline (Fase 1), sem nuvem/login
#  local   = simulação via DynamoDB Local (Docker)
#  amplify = produção real (requer amplify_outputs.json + credenciais)
VITE_CLOUD_MODE=off

# Modo de autenticação: off | dev | cognito
#  off     = sem login
#  dev     = login simulado (sem Cognito), para testes locais
#  cognito = login real com Google (produção)
VITE_AUTH_MODE=off

# Endpoint do DynamoDB Local (usado quando VITE_CLOUD_MODE=local)
VITE_DYNAMO_ENDPOINT=http://localhost:8001

# E-mail padrão do "Entrar" no modo dev (opcional)
VITE_DEV_EMAIL=higovale@gmail.com
